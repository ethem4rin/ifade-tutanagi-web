# Supabase baglantisi (Vercel > Settings > Environment Variables'a da eklenir)
# Supabase panel:  Settings > API Keys   ve   Connect (Project URL)

SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Yeni anahtar sistemi:  Settings > API Keys > "Secret key"  (sb_secret_... ile baslar)
# Eski projelerde: Legacy API keys sekmesindeki service_role anahtari (eyJ... ile baslar)
# Ikisi de desteklenir. Bu anahtar tam yetkilidir - gizli tutun, on yuze koymayin.
SUPABASE_KEY=sb_secret_xxxxxxxxxxxxxxxx
